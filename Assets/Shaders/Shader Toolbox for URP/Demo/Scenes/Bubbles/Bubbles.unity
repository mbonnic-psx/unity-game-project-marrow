--- !u!1001 &6856731668457398584
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 233505726427588918, guid: 5aa8f79cd6416fd4ea3f09ac4a61ebc3, type: 3}
      propertyPath: m_text
      value: Bubbles
      objectReference: {fileID: 0}
    - target: {fileID: 1846833183091735543, guid: 5aa8f79cd6416fd4ea3f09ac4a61ebc3, type: 3}
      propertyPath: m_text
      value: 'The Bubbles shader is a lot like the Glass shader, except it also overlays
        an iridescent rainbow pattern over the edge of the mesh, like a Fresnel highlight.


        You
        can choose the direction of flow of the rainbow pattern over the time with
        the help of the Apply Normal Map and Refract subgraphs.


        You can
        also choose whether to use a texture for the rainbow pattern or generate
        it automatically in the shader if no texture is applied.


        By default,
        you will not be able to see the bubbles in the background when you view them
        through this bubble. That is because the shader uses the Camera Opaque Texture,
        which only contains rendered opaque objects.'
      objectReference: {fileID: 0}
    - target: {fileID: 3285769109552880709, guid: 5aa8f79cd6416fd4ea3f09ac4a61ebc3, type: 3}
      propertyPath: m_RootOrder
