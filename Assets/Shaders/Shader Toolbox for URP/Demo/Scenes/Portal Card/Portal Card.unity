--- !u!1001 &6856731668457398584
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 233505726427588918, guid: 5aa8f79cd6416fd4ea3f09ac4a61ebc3, type: 3}
      propertyPath: m_text
      value: Portal Cards
      objectReference: {fileID: 0}
    - target: {fileID: 1846833183091735543, guid: 5aa8f79cd6416fd4ea3f09ac4a61ebc3, type: 3}
      propertyPath: m_text
      value: "A technique used in the game Abz\xFB revolves around meshes placed
        at the openings of sections of caves ('portals').\n\nThese 'portal cards'
        blend their colors based on the distance between the mesh and the object
        rendered into the depth buffer at the same screen coordinate.\n\nThey separately
        fade the alpha of the mesh based on the distance between the camera and the
        mesh pivot point.\n\nAs you move far away from the mesh, it will start to
        appear more solid, and you will clearly see the entrance to the cave section
        (depending on the colors you chose), emphasizing the direction you should
        travel in."
      objectReference: {fileID: 0}
    - target: {fileID: 3285769109552880709, guid: 5aa8f79cd6416fd4ea3f09ac4a61ebc3, type: 3}
      propertyPath: m_RootOrder
      value: 5
      objectReference: {fileID: 0}
